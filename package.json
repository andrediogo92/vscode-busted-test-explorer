{
  "name": "nu-busted-test-explorer",
  "displayName": "Nu Busted Test Explorer",
  "description": "Discover and run your lua busted tests from vscode",
  "version": "0.2.7",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrediogo92/vscode-busted-test-explorer"
  },
  "author": "Vivien HENRIET",
  "contributors": [
    {
      "name": "Vivien HENRIET"
    },
    {
      "name": "iDemetr"
    },
    {
      "name": "andrediogo92"
    }
  ],
  "publisher": "andrediogo92",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andrediogo92/vscode-busted-test-explorer/issues"
  },
  "homepage": "https://github.com/andrediogo92/vscode-busted-test-explorer",
  "icon": "res/logo.png",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Nu Busted Test Explorer",
      "properties": {
        "busted-test-explorer.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional busted command line option."
        },
        "busted-test-explorer.cwd": {
          "type": "string",
          "description": "Working directory used by busted during test runs."
        },
        "busted-test-explorer.luaVersion": {
          "type": "string",
          "enum": [
            "5.1",
            "5.2",
            "5.3",
            "LuaJIT"
          ],
          "default": "5.3",
          "description": "Lua version to target for parser."
        },
        "busted-test-explorer.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Environment variable appended to the environment when busted is executed."
        },
        "busted-test-explorer.testFilePattern": {
          "type": "string",
          "default": "**/*_spec.lua",
          "description": "Test file pattern"
        },
        "busted-test-explorer.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Logging verbosity in Output → Busted Test Explorer"
        },
        "busted-test-explorer.idleTimeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "Kill test run if there's no output for this many ms"
        },
        "busted-test-explorer.profile": {
          "type": "string",
          "enum": [
            "local",
            "wsl",
            "docker"
          ],
          "default": "local",
          "description": "From where to run busted"
        },
        "busted-test-explorer.localExecutable": {
          "type": "string",
          "minLength": 1,
          "default": "busted",
          "description": "Name or full path of the local busted executable. If only a name is provided, the executable must be in PATH."
        },
        "busted-test-explorer.wslExecutable": {
          "type": "string",
          "minLength": 1,
          "default": "wsl busted",
          "description": "Command to run busted inside WSL"
        },
        "busted-test-explorer.dockerExecutable": {
          "type": "string",
          "minLength": 1,
          "default": "docker run --rm my-lua busted",
          "description": "Command to run busted inside Docker"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@types/luaparse": "^0.2.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.3",
    "@types/vscode": "^1.138.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^8.0.1",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-mocha": "^10.0.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.2",
    "standard": "^17.1.2",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "js-base64": "^3.9.4",
    "luaparse": "^0.3.1",
    "minimatch": "^10.2.6",
    "vscode-test-adapter-api": "^1.9.0",
    "xxhash-addon": "^2.1.0"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "xxhash-addon@2.1.0": true
  }
}
